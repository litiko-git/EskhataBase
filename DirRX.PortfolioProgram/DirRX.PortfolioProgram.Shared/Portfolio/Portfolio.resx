  <data name="ClosePortfolioDialogMessage" xml:space="preserve">
    <value>Close the portfolio and move it to archive?</value>
  </data>
  <data name="ClosePortfolioDialogDescription" xml:space="preserve">
    <value>Portfolio, its child projects, programs and portfolios will be closed. The portfolio folder will be moved to the "Project Archive" folder.</value>
  </data>
  <data name="NoRightToUpdatePortfolio" xml:space="preserve">
    <value>You do not have sufficient access rights to change the portfolio.</value>
  </data>
  <data name="LeadingPortfolioCyclicReference" xml:space="preserve">
    <value>This is a child portfolio of the current portfolio. Select another one.</value>
  </data>
  <data name="ReopenPortfolioDialogMessage" xml:space="preserve">
    <value>Reopen the portfolio and retrieve it from archive?</value>
  </data>
  <data name="ReopenPortfolioDialogDescription" xml:space="preserve">
    <value>Portfolio will be opened. Its child projects, programs and portfolios will not be opened. The portfolio folder will be moved to the "Projects" folder.</value>
  </data>
