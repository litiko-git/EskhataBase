<Report ScriptLanguage="CSharp" ReferencedAssemblies="System.dll&#13;&#10;System.Core.dll&#13;&#10;System.Drawing.dll&#13;&#10;System.Windows.Forms.dll&#13;&#10;System.Data.dll&#13;&#10;System.Xml.dll&#13;&#10;Sungero.Domain.Shared&#13;&#10;Sungero.CoreEntities.Shared&#13;&#10;Sungero.Reporting.Shared&#13;&#10;CommonLibrary&#13;&#10;Sungero.Localization&#13;&#10;Sungero.Declension&#13;&#10;Sungero.Content.Shared&#13;&#10;Sungero.Domain.Interfaces&#13;&#10;Sungero.Workflow.Interfaces&#13;&#10;DirRX.ProjectPlanner.Shared&#13;&#10;DirRX.ProjectPlanner.Server" ReportInfo.CreatorVersion="2020.2.12.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text.RegularExpressions;
using System.Windows.Forms;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;
using DirRX.ProjectPlanner;
using Sungero.Domain.Shared;
using Sungero.CoreEntities;
using Sungero.Core;
using Resources = DirRX.ProjectPlanner.Reports.Resources;


namespace FastReport
{
  public class ReportScript
  {

    private void IncrementCountTable_AfterData(object sender, EventArgs e)
    {
     Report.SetParameterValue(&quot;CountTable&quot;, (int)Report.GetParameterValue(&quot;CountTable&quot;) + 1);
    }

    private void Page1_StartPage(object sender, EventArgs e)
    {
      if((bool)Report.GetParameterValue(&quot;IsIncludeAgile&quot;) != true)
      {
        CompletedTicketsPage.Visible = false;
        CurrentTicketsPage.Visible = false;
        StubTextPage.Visible = false;
      }
      
      if((bool)Report.GetParameterValue(&quot;HasAgileProject&quot;) != true)
      {
        CompletedTicketsPage.Visible = false;
        CurrentTicketsPage.Visible = false;
      }
      else
      {
         StubTextPage.Visible = false;
      }
    }
  }
}
  </ScriptText>
